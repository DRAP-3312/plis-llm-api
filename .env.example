# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plisllm
DB_USER=plisllm
DB_PASSWORD=changeme

# Stockfish (se usa a partir del paso 2 del plan)
STOCKFISH_URL=http://localhost:8080
STOCKFISH_TIMEOUT_EVAL_MS=200
STOCKFISH_TIMEOUT_CANDIDATES_MS=2000
STOCKFISH_TIMEOUT_PREDICTION_MS=1000

# LLM. LLM_PROVIDER solo soporta 'openai' por ahora.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=1000

# App
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=changeme
JWT_EXPIRES_IN_SECONDS=2592000
IP_HASH_SALT=changeme
TRUST_PROXY=false
AUTH_MAX_ACCOUNTS_PER_IP=3
GAMES_MAX_COMPLETED_PER_PLAYER=10
GAMES_MAX_COMPLETED_PER_IP_PER_DAY=30
